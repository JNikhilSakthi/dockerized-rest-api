# Copy this file to .env and adjust as needed. docker-compose.yml automatically
# reads a .env file in the same directory. All values here have safe local
# defaults baked into docker-compose.yml, so an .env file is optional for a
# first run.

# --- MySQL ---
MYSQL_ROOT_PASSWORD=root_pass
DB_NAME=catalog_db
DB_USERNAME=catalog_user
DB_PASSWORD=catalog_pass
# Host port MySQL is published on (change if 3306 is already taken locally).
MYSQL_EXPOSED_PORT=3306

# --- App ---
# Host port the REST API is published on.
APP_PORT=8080
# Extra JVM flags passed through to the container entrypoint, e.g. -Xlog:gc.
JAVA_OPTS=

# --- Adminer (web UI for MySQL, http://localhost:8081) ---
ADMINER_PORT=8081
